# Backend V4 example settings
# Copy this file to .env for local configuration.
# Never commit your real .env file.

ADMIN_PASSWORD=change-me
SECRET_KEY=change-this-to-a-long-random-secret
MAX_GUESTS_PER_SLOT=20

# Email mode:
# outbox = save email locally as .eml files
# smtp   = send real email through your email provider
EMAIL_MODE=outbox

RESTAURANT_EMAIL=restaurant@yourrestaurant.se
EMAIL_FROM=bookings@yourrestaurant.se

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourrestaurant.se
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
